# ===================================================
# TimberBooks Backend - Cloud Environment Configuration
# ===================================================

# Port to listen on (Render/Railway sets this automatically)
PORT=5000

# Node Environment: 'development' or 'production'
NODE_ENV=production

# JWT Authentication Secret Key (use a long, random string in production)
JWT_SECRET=timberbooks_super_secret_jwt_key_2026_production

# MongoDB Connection String
# - For MongoDB Atlas Cloud Database:
#   MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/timberbooks?retryWrites=true&w=majority
# - If left empty or commented out, TimberBooks automatically activates
#   its zero-dependency embedded persistent JSON store (backend/data/db.json).
MONGODB_URI=
