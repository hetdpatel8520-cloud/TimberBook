# ===================================================
# TimberBooks Backend - Cloud Environment Configuration
# ===================================================

# Port to listen on (Render sets this automatically)
PORT=5000

# Node Environment: 'development' or 'production'
NODE_ENV=production

# JWT Authentication Secret Key (use a long, random string in production)
JWT_SECRET=timberbooks_super_secret_jwt_key_2026_production

# MongoDB Atlas Connection Configuration
# - REQUIRED: Provide your MongoDB Atlas connection string (MONGO_URI or MONGODB_URI)
# - Note: Whitelist 0.0.0.0/0 in MongoDB Atlas Network Access so Render cloud containers can connect.
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/timberbooks?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/timberbooks?retryWrites=true&w=majority

# MongoDB Database Name (explicit in all environments)
MONGO_DB_NAME=timberbooks

# Optional Email SMTP Provider (Part A)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="TimberBooks Support <support@timberbooks.app>"

# Optional SMS Gateway Provider (Part A: 'msg91' or 'fast2sms')
SMS_PROVIDER=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=TMBRBS
MSG91_TEMPLATE_ID=
FAST2SMS_API_KEY=

# Developer Mode OTP Logging (Set true in development to log OTPs to console)
DEV_SHOW_OTP=false

